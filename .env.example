# Authentication provider. Keep false until the Casdoor application and callback are ready.
CASDOOR_AUTH_ENABLED=false
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-at-least-32-random-characters
CASDOOR_ISSUER=https://auth.example.com
CASDOOR_CLIENT_ID=software-store-web
# Casdoor uses S256 PKCE with no client secret. NEXTAUTH_SECRET belongs only to this store.

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxx.xxx._4rYTWNVOuHJGBbef-eUupzbdKyO3Wec5-ZI6csCdQQ
SUPABASE_SERVICE_ROLE_KEY=xxx.xxx.ftkFI83wmFKe9qa2tiRrKp58pa9c2KcRuIC3sC3K3UI

# Creem.io Payment Configuration
CREEM_TEST_MODE=true # Set to false for production
CREEM_WEBHOOK_SECRET=xxx
CREEM_API_KEY=creem_test_xxx
CREEM_API_URL=https://test-api.creem.io/v1
#生产环境用这个=> CREEM_API_URL=https://api.creem.io

# Site URLs
BASE_URL=http://localhost:3000
CREEM_SUCCESS_URL=http://localhost:3000/dashboard
# 生产环境用这2个=>
# BASE_URL=https://yourdomain.com
# CREEM_SUCCESS_URL=https://yourdomain.com/dashboard

# Software store infrastructure. Product and release content is managed in /admin/software.
RELEASE_STORAGE_ROOT=/app/data/releases
# Keep admin access fail-closed. Casdoor uses exact subjects only.
# Legacy user ids and emails apply only in Supabase mode.
OAKTECH_ADMIN_SUBJECTS=
OAKTECH_ADMIN_USER_IDS=
OAKTECH_ADMIN_EMAILS=
# Random value of at least 32 characters; shared only with the protected CI environment.
OAKTECH_RELEASE_WRITE_TOKEN=
